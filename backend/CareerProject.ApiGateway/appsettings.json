{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "CareerProject",
    "Audience": "CareerProject.Clients"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "userservice",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "skills-route": {
        "ClusterId": "userservice",
        "Match": { "Path": "/api/skills" }
      },
      "users-route": {
        "ClusterId": "userservice",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "profile-route": {
        "ClusterId": "userservice",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/profile/{**catch-all}" }
      },
      "company-route": {
        "ClusterId": "jobservice",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/company/{**catch-all}" }
      },
      "jobs-route": {
        "ClusterId": "jobservice",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/jobs/{**catch-all}" }
      },
      "applications-route": {
        "ClusterId": "jobservice",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/applications/{**catch-all}" }
      },
      "recommendations-route": {
        "ClusterId": "recommendationservice",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/recommendations/{**catch-all}" }
      },
      "ai-route": {
        "ClusterId": "recommendationservice",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/ai/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "notificationservice",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "userservice": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5269" }
        }
      },
      "jobservice": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5135" }
        }
      },
      "recommendationservice": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5190" }
        }
      },
      "notificationservice": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5156" }
        }
      }
    }
  }
}
